  deletedAt             DateTime?         @map("deleted_at")
  isDeleted             Boolean           @default(false) @map("is_deleted")
  deletedBy             String?           @map("deleted_by")

  @@map("production_plans")
}

model Machine {
  id                  String                      @id @default(uuid())
  code                String                      @unique
  name                String
  type                String                      // Corrugator, Flexo Printer, Rotary Die-Cutter, Automatic Stitcher, Pasting Machine
  line                String                      // Line 1, Line 2
  capacityPerHour     Float                       @default(0) @map("capacity_per_hour")
  unit                String                      @default("Sheets/Hr")
  status              String                      @default("Available") // Available | Running | Maintenance | Breakdown | Idle
  operator            String?
  lastMaintenanceDate String?                     @map("last_maintenance_date")
  nextMaintenanceDate String?                     @map("next_maintenance_date")
  operations          WorkOrderOperation[]
  processExecutions   ProductionProcessExecution[]
  downtimes           DowntimeLog[]
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  deletedAt           DateTime?                   @map("deleted_at")
  isDeleted           Boolean                     @default(false) @map("is_deleted")
  deletedBy           String?                     @map("deleted_by")

  @@map("machines")
}

model ProductionQC {
  id                  String    @id @default(uuid())
  qcNumber            String    @unique @map("qc_number")
  workOrderId         String    @map("work_order_id")
  workOrder           WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stage               String    // Corrugation | In-Process | Final Box QC
  inspectorName       String    @map("inspector_name")
  sampleSize          Int       @default(5) @map("sample_size")
  burstingFactor      Float?    @map("bursting_factor")
  burstingStrength    Float?    @map("bursting_strength") // kg/cm2
  moisturePercent     Float?    @map("moisture_percent") // %
  boxCompressionTest  Float?    @map("box_compression_test") // BCT (kgf)
  caliperThicknessMm  Float?    @map("caliper_thickness_mm") // mm
  dimensionCheck      String?   @default("Pass") @map("dimension_check") // Pass | Fail
  printQuality        String?   @default("Pass") @map("print_quality") // Pass | Fail | Minor Flaw
  status              String    @default("Passed") // Passed | Rejected | Conditional Pass
  rejectedQty         Float     @default(0) @map("rejected_qty")
  remarks             String?
  inspectionDate      String    @map("inspection_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("production_qc_inspections")
}

model ScrapLog {
  id           String     @id @default(uuid())
  scrapNumber  String     @unique @map("scrap_number")
  workOrderId  String?    @map("work_order_id")
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])
  stage        String     // Corrugator Trimming | Printing Misprint | Die-Cut Waste | Slotting Waste
  materialType String     @map("material_type")
  weightKg     Float      @map("weight_kg")
  reason       String
  recordedBy   String     @map("recorded_by")
  date         String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("production_scrap_logs")
}

model DowntimeLog {
  id              String    @id @default(uuid())
  machineId       String    @map("machine_id")
  machine         Machine   @relation(fields: [machineId], references: [id])
  reasonCategory  String    @map("reason_category") // Mechanical | Electrical | Roll Change | Cleaning | Operator Break | No Material
  durationMinutes Int       @map("duration_minutes")
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  resolvedBy      String?   @map("resolved_by")
  actionTaken     String?   @map("action_taken")
  date            String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("production_downtime_logs")
}

model CostSheet {
  id                            String                 @id @default(uuid())
  costSheetNumber               String                 @unique @map("cost_sheet_number")
  revision                      Int                    @default(1)
  title                         String?
  boxType                       String                 @default("Universal Box") @map("box_type") // Universal Box | Customized Box | Sheet Board | Die-Cut | Partition
  calculationType               String                 @default("Universal Box") @map("calculation_type")
  
  leadId                        String?                @map("lead_id")
  lead                          SalesLead?             @relation(fields: [leadId], references: [id])
  customerId                    String?                @map("customer_id")
  customer                      Customer?              @relation(fields: [customerId], references: [id])
  customerName                  String?                @map("customer_name")
  
  bomId                         String?                @map("bom_id")
  bom                           BillOfMaterial?        @relation(fields: [bomId], references: [id])
  
  productId                     String?                @map("product_id")
  product                       Product?               @relation(fields: [productId], references: [id])
  productName                   String?                @map("product_name")
  
  targetQuantity                Float                  @default(1000) @map("target_quantity")
  unit                          String                 @default("Pcs")
  dimensionUnit                 String                 @default("mm") @map("dimension_unit") // mm | inch
  
  length                        Float                  @default(0)
  width                         Float                  @default(0)
  height                        Float                  @default(0)
  jointFlapMm                   Float                  @default(35) @map("joint_flap_mm")
  creaseAllowanceMm             Float                  @default(0) @map("crease_allowance_mm")
  deckleSizeMm                  Float                  @default(0) @map("deckle_size_mm")
  cuttingLengthMm               Float                  @default(0) @map("cutting_length_mm")
  sheetAreaSqM                  Float                  @default(0) @map("sheet_area_sq_m")
  
  ply                           Int                    @default(3)
  fluteType                     String?                @map("flute_type") // B-Flute | C-Flute | E-Flute | BC-Flute | A-Flute
  fluteTakeUp                   Float                  @default(1.35) @map("flute_take_up")
  
  totalBoardGsm                 Float                  @default(0) @map("total_board_gsm")
  burstingFactor                Float                  @default(0) @map("bursting_factor")
  burstingStrength              Float                  @default(0) @map("bursting_strength")
  boxCompressionTest            Float                  @default(0) @map("box_compression_test")
  singleBoxWeightGrams          Float                  @default(0) @map("single_box_weight_grams")
  singleBoxWeightKg             Float                  @default(0) @map("single_box_weight_kg")
  
  paperCostPerBox               Float                  @default(0) @map("paper_cost_per_box")
  starchCostPerBox              Float                  @default(0) @map("starch_cost_per_box")
  printingCostPerBox            Float                  @default(0) @map("printing_cost_per_box")
  stitchingGlueCostPerBox       Float                  @default(0) @map("stitching_glue_cost_per_box")
  dieCostTotal                  Float                  @default(0) @map("die_cost_total")
  dieCostPerBox                 Float                  @default(0) @map("die_cost_per_box")
  plateStereoCostTotal          Float                  @default(0) @map("plate_stereo_cost_total")
  plateStereoCostPerBox         Float                  @default(0) @map("plate_stereo_cost_per_box")
  wastagePercent                Float                  @default(3) @map("wastage_percent")
  wastageCostPerBox             Float                  @default(0) @map("wastage_cost_per_box")
  conversionLaborCostPerBox     Float                  @default(0) @map("conversion_labor_cost_per_box")
  overheadCostPerBox            Float                  @default(0) @map("overhead_cost_per_box")
  freightCostPerBox             Float                  @default(0) @map("freight_cost_per_box")
  otherCostPerBox               Float                  @default(0) @map("other_cost_per_box")
  totalManufacturingCostPerBox  Float                  @default(0) @map("total_manufacturing_cost_per_box")
  
  profitMarginPercent           Float                  @default(15) @map("profit_margin_percent")
  profitAmountPerBox            Float                  @default(0) @map("profit_amount_per_box")
  sellingPricePerBox            Float                  @default(0) @map("selling_price_per_box")
  totalOrderValue               Float                  @default(0) @map("total_order_value")
  taxRate                       Float                  @default(18) @map("tax_rate")
  taxAmount                     Float                  @default(0) @map("tax_amount")
  grandTotalValue               Float                  @default(0) @map("grand_total_value")
  
  status                        String                 @default("Draft") // Draft | Submitted | Pending MD Approval | Approved | Rejected | Revision Requested | Converted to Quotation
  preparedBy                    String?                @map("prepared_by")
  approvedBy                    String?                @map("approved_by")
  approvedAt                    DateTime?              @map("approved_at")
  mdRemarks                     String?                @map("md_remarks")
  notes                         String?
  specifications                String?
  
  layers                        CostSheetLayer[]
  approvals                     CostSheetApproval[]
  revisions                     CostSheetRevision[]
  quotations                    SalesQuotation[]
  
  isDeleted                     Boolean                @default(false) @map("is_deleted")
  deletedAt                     DateTime?              @map("deleted_at")
  deletedBy                     String?                @map("deleted_by")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")

  @@map("cost_sheets")
}

model CostSheetLayer {
  id           String       @id @default(uuid())
  costSheetId  String       @map("cost_sheet_id")
  costSheet    CostSheet    @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  layerIndex   Int          @default(0) @map("layer_index")
  layerName    String       @map("layer_name")
  layerType    String       @default("Liner") @map("layer_type") // Liner | Fluting
  materialId   String?      @map("material_id")
  material     RawMaterial? @relation(fields: [materialId], references: [id])
  paperGrade   String       @map("paper_grade")
  gsm          Float        @default(120)
  bf           Float        @default(18)
  fluteType    String?      @map("flute_type")
  fluteFactor  Float        @default(1.0) @map("flute_factor")
  weightGrams  Float        @default(0) @map("weight_grams")
  ratePerKg    Float        @default(0) @map("rate_per_kg")
  costPerBox   Float        @default(0) @map("cost_per_box")
  remarks      String?
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("cost_sheet_layers")
}

model CostSheetApproval {
  id             String    @id @default(uuid())
  costSheetId    String    @map("cost_sheet_id")
  costSheet      CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  action         String    // Submitted | Approved | Rejected | Revision Requested | Commented
  status         String    // Pending | Approved | Rejected
  userName       String    @map("user_name")
  userRole       String?   @map("user_role")
  remarks        String?
  priceAtReview  Float?    @map("price_at_review")
  marginAtReview Float?    @map("margin_at_review")
  timestamp      DateTime  @default(now())

  @@map("cost_sheet_approvals")
}

model CostSheetRevision {
  id             String    @id @default(uuid())
  costSheetId    String    @map("cost_sheet_id")
  costSheet      CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  revisionNumber Int       @map("revision_number")
  snapshotData   String    @map("snapshot_data")
  reason         String?
  changedBy      String?   @map("changed_by")
  sellingPrice   Float     @default(0) @map("selling_price")
  profitMargin   Float     @default(0) @map("profit_margin")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("cost_sheet_revisions")
}

// ==========================================
// PHASE 2: PRODUCTION & PLANNING MODELS
// ==========================================

model ProductionOrder {
  id                  String                       @id @default(uuid())
  orderNumber         String                       @unique @map("order_number")
  productionDate      String                       @map("production_date")
  productionPlanId    String?                      @map("production_plan_id")
  productionPlan      ProductionPlan?              @relation(fields: [productionPlanId], references: [id])
  workOrderId         String                       @map("work_order_id")
  workOrder           WorkOrder                    @relation(fields: [workOrderId], references: [id])
  salesOrderId        String?                      @map("sales_order_id")
  salesOrder          SalesOrderEntity?            @relation(fields: [salesOrderId], references: [id])
  productId           String                       @map("product_id")
  product             Product                      @relation(fields: [productId], references: [id])
  bomId               String?                      @map("bom_id")
  bom                 BillOfMaterial?              @relation(fields: [bomId], references: [id])
  plannedQuantity     Float                        @map("planned_quantity")
  actualQuantity      Float                        @default(0) @map("actual_quantity")
  balanceQuantity     Float                        @default(0) @map("balance_quantity")
  scrapQuantity       Float                        @default(0) @map("scrap_quantity")
  wastageQuantity     Float                        @default(0) @map("wastage_quantity")
  status              String                       @default("Draft") // Draft | Planned | Material Pending | Material Allocated | Material Issued | In Production | Partially Completed | Completed | QC Pending | QC Approved | Rejected | Cancelled
  currentProcessIndex Int                          @default(0) @map("current_process_index")
  supervisor          String?
  remarks             String?
  processSteps        ProductionProcessExecution[]
  materialRequests    MaterialRequest[]
  materialAllocations MaterialAllocation[]
  materialIssues      ProductionMaterialIssue[]
  materialConsumptions MaterialConsumption[]
  materialReturns     ProductionMaterialReturn[]
  dailyReports        DailyProductionReport[]
  qcInspections       QualityCheck[]               @relation("ProductionOrderQCs")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  deletedAt           DateTime?                    @map("deleted_at")
  isDeleted           Boolean                      @default(false) @map("is_deleted")
  deletedBy           String?                      @map("deleted_by")

  @@map("production_orders")
}

model ProductionProcessExecution {
  id                     String          @id @default(uuid())
  productionOrderId      String          @map("production_order_id")
  productionOrder        ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sequence               Int
  processName            String          @map("process_name")
  machineId              String?         @map("machine_id")
  machine                Machine?        @relation(fields: [machineId], references: [id])
  machineName            String?         @map("machine_name")
  operatorName           String?         @map("operator_name")
  status                 String          @default("Pending") // Pending | In Progress | Completed | Paused | QC Pending | QC Approved | QC Rejected
  plannedQuantity        Float           @default(0) @map("planned_quantity")
  inputQuantity          Float           @default(0) @map("input_quantity")
  materialConsumed       Float           @default(0) @map("material_consumed")
  actualProducedQuantity Float           @default(0) @map("actual_produced_quantity")
  pendingQuantity        Float           @default(0) @map("pending_quantity")
  scrapQuantity          Float           @default(0) @map("scrap_quantity")
  wastageQuantity        Float           @default(0) @map("wastage_quantity")
  startTime              DateTime?       @map("start_time")
  endTime                DateTime?       @map("end_time")
  qcStatus               String?         @default("Pending") @map("qc_status") // Pending | Passed | Rejected | Rework | Hold
  qcRemarks              String?         @map("qc_remarks")
  remarks                String?
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@map("production_process_executions")
}

model MaterialRequest {
  id                String               @id @default(uuid())
  indentNumber      String               @unique @map("indent_number")
  productionOrderId String?              @map("production_order_id")
  productionOrder   ProductionOrder?     @relation(fields: [productionOrderId], references: [id])
  workOrderId       String?              @map("work_order_id")
  workOrder         WorkOrder?           @relation(fields: [workOrderId], references: [id])
  productId         String?              @map("product_id")
  product           Product?             @relation(fields: [productId], references: [id])
  rawMaterialId     String               @map("raw_material_id")
  rawMaterial       RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  requiredQuantity  Float                @map("required_quantity")
  allocatedQuantity Float                @default(0) @map("allocated_quantity")
  issuedQuantity    Float                @default(0) @map("issued_quantity")
  uom               String               @default("Kg")
  requiredDate      String               @map("required_date")
  requestedBy       String               @map("requested_by")
  status            String               @default("Requested") // Requested | Approved | Allocated | Issued | Partially Issued | Completed | Rejected
  remarks           String?
  allocations       MaterialAllocation[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
  isDeleted         Boolean              @default(false) @map("is_deleted")
  deletedBy         String?              @map("deleted_by")

  @@map("material_requests")
}

model MaterialAllocation {
  id                     String           @id @default(uuid())
  allocationNumber       String           @unique @map("allocation_number")
  materialRequestId      String?          @map("material_request_id")
  materialRequest        MaterialRequest? @relation(fields: [materialRequestId], references: [id])
  productionOrderId      String?          @map("production_order_id")
  productionOrder        ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  rawMaterialId          String           @map("raw_material_id")
  rawMaterial            RawMaterial      @relation(fields: [rawMaterialId], references: [id])
  rawMaterialStockId     String?          @map("raw_material_stock_id")
  rawMaterialStock       RawMaterialStock? @relation(fields: [rawMaterialStockId], references: [id])
  batchLotNumber         String?          @map("batch_lot_number")
  supplierName           String?          @map("supplier_name")
  quantity               Float
  sourceWarehouseId      String           @map("source_warehouse_id")
  sourceWarehouse        Warehouse        @relation("SourceWarehouseAllocations", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String           @map("destination_warehouse_id")
  destinationWarehouse   Warehouse        @relation("DestinationWarehouseAllocations", fields: [destinationWarehouseId], references: [id])
  allocationDate         String           @map("allocation_date")
  allocatedBy            String           @map("allocated_by")
  status                 String           @default("Allocated") // Allocated | IssuedToProduction | ReturnedToGodown1 | Released
  releasedAt             DateTime?        @map("released_at")
  releasedBy             String?          @map("released_by")
  releaseReason          String?          @map("release_reason")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  @@map("material_allocations")
}

model ProductionMaterialIssue {
  id                String          @id @default(uuid())
  issueNumber       String          @unique @map("issue_number")
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  allocationId      String?         @map("allocation_id")
  rawMaterialId     String          @map("raw_material_id")
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  batchLotNumber    String?         @map("batch_lot_number")
  quantityIssued    Float           @map("quantity_issued")
  warehouseId       String          @map("warehouse_id")
  warehouse         Warehouse       @relation("WarehouseMaterialIssues", fields: [warehouseId], references: [id])
  operatorTeam      String?         @map("operator_team")
  issueDate         String          @map("issue_date")
  issuedBy          String          @map("issued_by")
  reference         String?
  remarks           String?
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("production_material_issues")
}

model MaterialConsumption {
  id                String          @id @default(uuid())
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  rawMaterialId     String          @map("raw_material_id")
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  batchLotNumber    String?         @map("batch_lot_number")
  issuedQuantity    Float           @default(0) @map("issued_quantity")
  usedQuantity      Float           @default(0) @map("used_quantity")
  returnedQuantity  Float           @default(0) @map("returned_quantity")
  wastageQuantity   Float           @default(0) @map("wastage_quantity")
  balanceQuantity   Float           @default(0) @map("balance_quantity")
  recordedBy        String?         @map("recorded_by")
  date              String
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@map("material_consumptions")
}

model ProductionMaterialReturn {
  id                     String          @id @default(uuid())
  returnNumber           String          @unique @map("return_number")
  productionOrderId      String          @map("production_order_id")
  productionOrder        ProductionOrder @relation(fields: [productionOrderId], references: [id])
  rawMaterialId          String          @map("raw_material_id")
  rawMaterial            RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  batchLotNumber         String?         @map("batch_lot_number")
  quantityReturned       Float           @map("quantity_returned")
  destinationWarehouseId String          @map("destination_warehouse_id")
  destinationWarehouse   Warehouse       @relation("WarehouseMaterialReturns", fields: [destinationWarehouseId], references: [id])
  returnDate             String          @map("return_date")
  returnedBy             String          @map("returned_by")
  receivedBy             String?         @map("received_by")
  reason                 String
  status                 String          @default("Received") // Pending | Received
  createdAt              DateTime        @default(now()) @map("created_at")

  @@map("production_material_returns")
}

model DailyProductionReport {
  id                     String            @id @default(uuid())
  reportNumber           String            @unique @map("report_number")
  productionDate         String            @map("production_date")
  workOrderId            String?           @map("work_order_id")
  workOrder              WorkOrder?        @relation(fields: [workOrderId], references: [id])
  productionOrderId      String?           @map("production_order_id")
  productionOrder        ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  salesOrderId           String?           @map("sales_order_id")
  salesOrder             SalesOrderEntity? @relation(fields: [salesOrderId], references: [id])
  productId              String            @map("product_id")
  product                Product           @relation(fields: [productId], references: [id])
  plannedQuantity        Float             @map("planned_quantity")
  actualProducedQuantity Float             @map("actual_produced_quantity")
  balanceQuantity        Float             @map("balance_quantity")
  scrapQuantity          Float             @default(0) @map("scrap_quantity")
  wastageQuantity        Float             @default(0) @map("wastage_quantity")
  materialIssued         Float             @default(0) @map("material_issued")
  materialConsumed       Float             @default(0) @map("material_consumed")
  materialReturned       Float             @default(0) @map("material_returned")
  achievementPercent     Float             @default(0) @map("achievement_percent")
  reasonForNonCompletion String?           @map("reason_for_non_completion")
  operator               String?
  supervisor             String?
  status                 String            @default("Pending Manager Approval") // Pending Manager Approval | Approved | Rejected
  approvedBy             String?           @map("approved_by")
  approvalDate           DateTime?         @map("approval_date")
  managerRemarks         String?           @map("manager_remarks")
  remarks                String?
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  deletedAt              DateTime?         @map("deleted_at")
  isDeleted              Boolean           @default(false) @map("is_deleted")
  deletedBy              String?           @map("deleted_by")

  @@map("daily_production_reports")
}


